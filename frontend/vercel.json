{
"cleanUrls": true,
"rewrites": [
{
"source": "/((?!about\.html|privacy\.html|terms\.html|guides\.html|ads\.txt|robots\.txt|sitemap\.xml|.\.[a-zA-Z0-9]+$).)",
"destination": "/index.html"
}
],
"headers": [
{
"source": "/(.*)",
"headers": [
{
"key": "X-Content-Type-Options",
"value": "nosniff"
},
{
"key": "X-Frame-Options",
"value": "DENY"
}
]
},
{
"source": "/ads.txt",
"headers": [
{
"key": "Content-Type",
"value": "text/plain; charset=utf-8"
}
]
}
]
}
